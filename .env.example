# --- Transcription -----------------------------------------------------------
WHISPER_MODEL=large-v3-turbo      # ~6x plus rapide que large-v3 ; remettre large-v3 pour la qualité maximale
WHISPER_DEVICE=cpu              # remplacé par "cuda" via docker-compose.gpu.yml
WHISPER_COMPUTE_TYPE=int8       # cuda -> float16
LANGUAGE=auto                   # 'auto' = détection ; ou fr, en, es...
VAD_FILTER=true

# --- Découpage ---------------------------------------------------------------
CHUNK_DURATION=1800             # 30 min par chunk
CHUNK_OVERLAP=2                 # recouvrement en secondes
DELETE_CHUNKS_AFTER=true

# --- Chemins (dans le conteneur) ---------------------------------------------
MEDIA_DIR=/media
WORK_DIR=/data/tmp
OUTPUT_DIR=/data/out

# --- Compression -------------------------------------------------------------
# TARGET_SIZE_GB=450            # décommenter pour viser une taille ;
#                              # sinon encodage CRF (qualité constante)
VIDEO_CODEC=libx265             # hevc_nvenc si GPU
CRF=24
PRESET=medium
AUDIO_BITRATE=128k

# --- Images explicatives (optionnel) -----------------------------------------
ENABLE_OCR=false
FRAME_INTERVAL=2                # secondes entre deux échantillons
SCENE_THRESHOLD=18              # écart moyen déclenchant une capture

# --- Réseau ------------------------------------------------------------------
API_PORT=8100                   # port exposé sur l'hôte (8000 et 8080 déjà pris ici)
# Interface d'écoute des ports publiés (API, Qdrant). 127.0.0.1 = cette machine
# seulement. 0.0.0.0 ouvre au réseau local : l'API n'a pas d'authentification.
BIND_ADDRESS=127.0.0.1

# --- Sécurité ----------------------------------------------------------------
# Par défaut, aucune connexion : l'API n'écoute que sur cette machine et refuse
# les autres noms d'hôte et les requêtes venant d'autres sites web.
REQUIRE_TOKEN=false
ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Jeton, utilisé seulement si REQUIRE_TOKEN=true (obligatoire avec BIND_ADDRESS=0.0.0.0).
# Générer : openssl rand -hex 32   — vide : généré dans /data/api_token (journal de l'API)
API_TOKEN=
# Mot de passe PostgreSQL, obligatoire. Générer : openssl rand -hex 24
# Sur une base déjà créée, changer aussi le mot de passe dans PostgreSQL :
#   docker compose exec postgres psql -U transcription -c "ALTER USER transcription PASSWORD '…'"
POSTGRES_PASSWORD=

# --- Services ----------------------------------------------------------------
# DATABASE_URL est construite par docker-compose.yml à partir de POSTGRES_PASSWORD.
REDIS_URL=redis://redis:6379/0

# --- RAG / Qdrant ------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_PORT=6333                # port exposé sur l'hôte
QDRANT_COLLECTION=transcriptions
EMBEDDING_MODEL=intfloat/multilingual-e5-large
RAG_CHUNK_CHARS=1200
RAG_OVERLAP_SEGMENTS=1

# --- Gros volumes (plusieurs To) ---------------------------------------------
# Dossier source monté en lecture seule sur /media. Les fichiers y sont traités
# sur place, sans copie ni upload. Ex. disque externe : /mnt/e/videos
MEDIA_PATH=./media
# Dossier où arrivent les fichiers compressés et les transcriptions.
OUTPUT_PATH=./output
# Fichiers temporaires : piste audio extraite (~115 Mo par heure de vidéo),
# morceaux, uploads. Vide = volume Docker, sur le disque de WSL (donc C:).
# Pour une vidéo de plusieurs centaines d'heures, un dossier sur le gros disque :
# WORK_PATH=/mnt/e/transcription-travail
# Débit total (kbps) sous lequel une vidéo est découpée en parties ≤ taille max
# plutôt que dégradée en un seul fichier. 1000 ≈ 720p lisible.
SPLIT_MIN_KBPS=1000
